# Deployment identity. Use a distinct value per running instance.
BRIDGE_INSTANCE_ID=instance-name

# Discord bot token from the Discord Developer Portal.
DISCORD_BOT_TOKEN=

# n8n webhook ingress URL for this deployment.
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/<path>

# Shared-secret header sent on every webhook POST.
N8N_AUTH_HEADER_NAME=X-Discord-Ingress-Key
N8N_AUTH_HEADER_VALUE=

# Comma-separated Discord guild (server) IDs that may emit events.
# At least one guild ID is required unless direct messages are enabled.
DISCORD_GUILD_IDS=guild-id-1,guild-id-2

# Comma-separated channel IDs. Empty means every channel in the allowlisted guilds.
# Thread IDs are routable channel IDs; a parent channel ID also admits its threads.
DISCORD_CHANNEL_IDS=channel-id-1,channel-id-2

# When true, DirectMessages intent is enabled and DMs are eligible for delivery.
DISCORD_ENABLE_DIRECT_MESSAGES=false

NODE_ENV=production
LOG_LEVEL=info
HTTP_TIMEOUT_MS=10000
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_MS=1000
MAX_IN_FLIGHT_DELIVERIES=32
